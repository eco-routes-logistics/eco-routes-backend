# Server
PORT=5000
NODE_ENV=development
MONGODB_URI=
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
FRONTEND_URL=http://localhost:5173
ADMIN_PANEL_URL=http://localhost:5173

# Rider ID uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments (wallet top-ups stay disabled until this is set)
PAYSTACK_SECRET_KEY=
PAYMENT_CALLBACK_URL=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OPS_EMAIL=

# First super admin: `npm run create-admin`, then remove these
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

# Demo accounts: `npm run seed:demo`. One shared password for every demo login.
# Refuses to run with NODE_ENV=production unless ALLOW_DEMO_ACCOUNTS=true.
DEMO_PASSWORD=
ALLOW_DEMO_ACCOUNTS=false
